# --- Alap ---
PORT=3000
# Az app nyilvános címe (az e-mailekben lévő linkekhez)
APP_URL=https://korus.cantemus.hu
NODE_ENV=production
DB_PATH=./data/cantapp.db

# Ezek a címek mindig adminok (vesszővel elválasztva). Első induláskor ezzel tudsz belépni.
ADMIN_EMAILS=korusasszisztens@cantemus.hu,support@cantemus.hu

# --- E-mail küldés ---
# A) HTTPS API (ajánlott; ott is működik, ahol az SMTP tiltva van):
# EMAIL_PROVIDER=brevo
# EMAIL_API_KEY=xkeysib-...
# B) SMTP. Ha egyik sincs beállítva, az e-mailek nem mennek ki, csak a szerver naplójába kerülnek.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Cantemus Kórus <noreply@cantemus.hu>"

# --- Push értesítések (nem kötelező: ha üres, az app első induláskor generál és eltárol egy kulcspárt) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@cantemus.hu

# --- Ütemezés (opcionális) ---
# Riport címzettjei (az admin felületen is módosítható)
REPORT_RECIPIENTS=korusasszisztens@cantemus.hu,foldesi.ildiko@cantemus.hu,szabo.soma@cantemus.hu,support@cantemus.hu
# Automatikus emlékeztetők ennyi órától (budapesti idő)
REMINDER_HOUR=9
# Riport a határidőt követő napon ennyi órakor
REPORT_HOUR=8
# Alapértelmezett határidő: ennyi nappal az esemény előtt
DEFAULT_DEADLINE_DAYS=7

# --- Közel lakók (OpenStreetMap helykeresés) ---
# GEOCODING=off kikapcsolja. A szolgáltatás szabályai szerint egy elérhetőséget kell megadni.
GEOCODER_CONTACT=support@cantemus.hu
