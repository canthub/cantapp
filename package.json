{
  "name": "cantapp",
  "version": "1.0.0",
  "description": "Cantemus Vegyeskar és Pro Musica – eseménykezelő és visszajelző alkalmazás",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "NODE_ENV=test node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "templates": "node scripts/make-templates.js",
    "vapid": "node scripts/generate-vapid.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed-demo.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canthub/cantapp.git"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/canthub/cantapp/issues"
  },
  "homepage": "https://github.com/canthub/cantapp#readme",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "luxon": "^3.7.2",
    "multer": "^2.5.0",
    "node-ical": "^0.27.3",
    "nodemailer": "^10.2.1",
    "papaparse": "^5.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
